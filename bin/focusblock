#!/bin/bash
#
# focusblock: block distracting sites on macOS through /etc/hosts,
# optionally with a timer that won't let you unblock early.
#
# Written for the bash 3.2 that ships with macOS, so no associative
# arrays, mapfile or ${var,,}.

set -euo pipefail
set -f  # no globbing: a target like "*" must never expand to file names

VERSION="0.1.0"

HOSTS_FILE="${FOCUSBLOCK_HOSTS:-/etc/hosts}"
STATE_DIR="${FOCUSBLOCK_STATE_DIR:-/var/db/focusblock}"
LAUNCHD_DIR="${FOCUSBLOCK_LAUNCHD_DIR:-/Library/LaunchDaemons}"
LABEL="local.focusblock.timer"
MARK_START="# FOCUSBLOCK-START"
MARK_END="# FOCUSBLOCK-END"
DRY_RUN=0

# ---------------------------------------------------------------- helpers

die()  { printf 'focusblock: %s\n' "$*" >&2; exit 1; }
info() { printf '%s\n' "$*"; }

now() { printf '%s\n' "${FOCUSBLOCK_NOW:-$(date +%s)}"; }

# Epoch -> local time. BSD date (macOS) first, GNU date (Linux CI) second.
fmt_time() {
  date -r "$1" '+%Y-%m-%d %H:%M' 2>/dev/null || date -d "@$1" '+%Y-%m-%d %H:%M'
}

# Seconds -> "1h 05m".
fmt_left() {
  local s="$1" h m
  h=$((s / 3600)); m=$(((s % 3600 + 59) / 60))
  if [ "$m" -eq 60 ]; then h=$((h + 1)); m=0; fi
  if [ "$h" -gt 0 ]; then printf '%dh %02dm\n' "$h" "$m"; else printf '%dm\n' "$m"; fi
}

# "1h30m", "45m", "2d" -> seconds. Fails on anything else.
parse_duration() {
  local s="$1" total=0 num unit
  [[ "$s" =~ ^([0-9]+[dhm])+$ ]] || return 1
  while [ -n "$s" ]; do
    [[ "$s" =~ ^([0-9]+)([dhm])(.*)$ ]]
    num=$((10#${BASH_REMATCH[1]})); unit="${BASH_REMATCH[2]}"; s="${BASH_REMATCH[3]}"
    case "$unit" in
      d) total=$((total + num * 86400)) ;;
      h) total=$((total + num * 3600)) ;;
      m) total=$((total + num * 60)) ;;
    esac
  done
  [ "$total" -gt 0 ] || return 1
  printf '%s\n' "$total"
}

# Directory of this script, following symlinks (no readlink -f on older macOS).
self_dir() {
  local src="${BASH_SOURCE[0]}" dir
  while [ -L "$src" ]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
  done
  cd -P "$(dirname "$src")" && pwd
}

self_path() { printf '%s/%s\n' "$(self_dir)" "$(basename "${BASH_SOURCE[0]}")"; }

lists_dir() {
  if [ -n "${FOCUSBLOCK_LISTS_DIR:-}" ]; then
    printf '%s\n' "$FOCUSBLOCK_LISTS_DIR"; return
  fi
  local here d
  here="$(self_dir)"
  for d in "$here/../lists" "$here/../share/focusblock/lists"; do
    if [ -d "$d" ]; then (cd "$d" && pwd); return; fi
  done
  die "can't find the site lists; set FOCUSBLOCK_LISTS_DIR"
}

# Strict hostname check. This is the only thing standing between user input
# and a system file, so nothing but letters, digits, dots and hyphens gets in.
valid_domain() {
  [[ "$1" =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)+$ ]]
}

valid_list_name() { [[ "$1" =~ ^[a-z0-9_-]+$ ]]; }

# Domains for one target: a list name (netflix) or a raw domain (example.com).
domains_for() {
  local target="$1" file
  if valid_list_name "$target"; then
    file="$(lists_dir)/$target.txt"
    if [ -f "$file" ]; then
      sed -e 's/#.*//' -e 's/[[:space:]]//g' "$file" | awk 'NF'
      return
    fi
  fi
  if valid_domain "$target"; then
    printf '%s\n' "$target"
    case "$target" in www.*) ;; *) printf 'www.%s\n' "$target" ;; esac
    return
  fi
  die "unknown site or list: '$target' (see: focusblock lists)"
}

# Comma-joined, de-duplicated, order kept.
join_unique() { tr ' ' ',' | tr ',' '\n' | awk 'NF && !seen[$0]++' | paste -sd, -; }

# --------------------------------------------------------------- hosts file

is_blocked() { grep -q "^$MARK_START" "$HOSTS_FILE"; }

current_targets() {
  sed -n "s/^$MARK_START targets=//p" "$HOSTS_FILE" | head -n 1
}

# Print the hosts file without our block, and without the one blank line we
# put in front of it, so on -> off gives back the original file byte for byte.
hosts_without_block() {
  awk -v start="$MARK_START" -v end="$MARK_END" '
    index($0, start) == 1 { for (i = 1; i < nb; i++) print ""; nb = 0; skip = 1; next }
    index($0, end) == 1   { skip = 0; next }
    skip                  { next }
    /^[[:space:]]*$/      { nb++; next }
                          { for (i = 0; i < nb; i++) print ""; nb = 0; print }
    END                   { for (i = 0; i < nb; i++) print "" }
  ' "$HOSTS_FILE"
}

render_block() {
  local targets="$1" t d
  printf '\n%s targets=%s\n' "$MARK_START" "$targets"
  printf '# Added by focusblock. Remove with: sudo focusblock off\n'
  {
    for t in $(printf '%s' "$targets" | tr ',' ' '); do domains_for "$t"; done
  } | awk '!seen[$0]++' | while IFS= read -r d; do
    printf '0.0.0.0 %s\n:: %s\n' "$d" "$d"
  done
  printf '%s\n' "$MARK_END"
}

require_writable() {
  [ -w "$HOSTS_FILE" ] || die "can't write $HOSTS_FILE. Run it with sudo."
}

# Rewrite in place (cat >) so the file keeps its owner and permissions.
write_hosts() {
  local tmp="$1"
  cat "$tmp" > "$HOSTS_FILE"
  rm -f "$tmp"
}

backup_once() {
  mkdir -p "$STATE_DIR"
  [ -f "$STATE_DIR/hosts.backup" ] || cp "$HOSTS_FILE" "$STATE_DIR/hosts.backup"
}

flush_dns() {
  [ "${FOCUSBLOCK_NO_FLUSH:-0}" = 1 ] && return 0
  [ "$(uname -s)" = Darwin ] || return 0
  dscacheutil -flushcache 2>/dev/null || true
  killall -HUP mDNSResponder 2>/dev/null || true
}

# -------------------------------------------------------------- timer lock

lock_until() {
  if [ -f "$STATE_DIR/until" ]; then cat "$STATE_DIR/until"; else printf '0\n'; fi
}

is_locked() { [ "$(lock_until)" -gt "$(now)" ]; }

plist_path() { printf '%s/%s.plist\n' "$LAUNCHD_DIR" "$LABEL"; }

# A launchd daemon runs "focusblock tick" every minute and at boot. The
# script is copied into the root-owned state dir first: launchd can't run it
# from ~/Downloads (macOS privacy rules), and it keeps working if the repo moves.
install_timer() {
  local runner="$STATE_DIR/focusblock" plist
  plist="$(plist_path)"
  cp "$(self_path)" "$runner"
  chmod 755 "$runner"
  mkdir -p "$LAUNCHD_DIR"
  cat > "$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>$runner</string>
    <string>tick</string>
  </array>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
EOF
  chmod 644 "$plist"
  [ "${FOCUSBLOCK_NO_LAUNCHD:-0}" = 1 ] && return 0
  launchctl bootout "system/$LABEL" 2>/dev/null || true
  launchctl bootstrap system "$plist"
}

remove_timer() {
  rm -f "$STATE_DIR/until"
  if [ "${FOCUSBLOCK_NO_LAUNCHD:-0}" != 1 ]; then
    launchctl bootout "system/$LABEL" 2>/dev/null || true
  fi
  rm -f "$(plist_path)" "$STATE_DIR/focusblock"
}

unblock() {
  local tmp
  tmp="$(mktemp)"
  hosts_without_block > "$tmp"
  write_hosts "$tmp"
  remove_timer
  flush_dns
}

# ---------------------------------------------------------------- commands

cmd_on() {
  local targets="" dur="" has_dur=0 secs until old t tmp
  while [ $# -gt 0 ]; do
    case "$1" in
      --for)   [ $# -ge 2 ] || die "--for needs a duration, e.g. --for 2h"; dur="$2"; has_dur=1; shift 2 ;;
      --for=*) dur="${1#--for=}"; has_dur=1; shift ;;
      -*)      die "unknown option: $1" ;;
      *)       targets="$targets $1"; shift ;;
    esac
  done
  [ -n "${targets// /}" ] || die "what should I block? e.g. focusblock on netflix"

  # Lower-case list names; raw domains are case-insensitive anyway.
  targets="$(printf '%s' "$targets" | tr '[:upper:]' '[:lower:]')"
  if is_blocked; then targets="$(current_targets) $targets"; fi
  targets="$(printf '%s' "$targets" | join_unique)"
  for t in $(printf '%s' "$targets" | tr ',' ' '); do domains_for "$t" > /dev/null; done

  until=0
  if [ "$has_dur" = 1 ]; then
    secs="$(parse_duration "$dur")" || die "can't read duration '$dur'. Use e.g. 45m, 2h, 1h30m, 1d."
    until=$(($(now) + secs))
    old="$(lock_until)"
    if [ "$old" -gt "$until" ]; then
      info "Already locked until $(fmt_time "$old"). Keeping the later time."
      until="$old"
    fi
  fi

  if [ "$DRY_RUN" = 1 ]; then
    info "Dry run: nothing changed. This would be added to $HOSTS_FILE:"
    render_block "$targets"
    [ "$until" -gt 0 ] && info "and the block would stay locked until $(fmt_time "$until")."
    return 0
  fi

  require_writable
  backup_once
  tmp="$(mktemp)"
  { hosts_without_block; render_block "$targets"; } > "$tmp"
  write_hosts "$tmp"
  if [ "$until" -gt 0 ]; then
    printf '%s\n' "$until" > "$STATE_DIR/until"
    install_timer
  fi
  flush_dns

  info "Blocked: $(printf '%s' "$targets" | sed 's/,/, /g')"
  if [ "$until" -gt 0 ]; then
    info "Locked until $(fmt_time "$until"). It will unblock itself then."
  fi
  info "Restart your browser so it drops cached connections."
}

cmd_off() {
  if ! is_blocked; then info "Nothing is blocked."; return 0; fi
  if is_locked; then
    die "locked until $(fmt_time "$(lock_until)") ($(fmt_left $(($(lock_until) - $(now)))) left). Stay strong."
  fi
  if [ "$DRY_RUN" = 1 ]; then
    info "Dry run: would remove the block for $(current_targets)."; return 0
  fi
  require_writable
  unblock
  info "Unblocked. Welcome back."
}

cmd_status() {
  if ! is_blocked; then info "Nothing is blocked."; return 0; fi
  local n
  n="$(grep -c '^0\.0\.0\.0 ' "$HOSTS_FILE" || true)"
  info "Blocked: $(current_targets | sed 's/,/, /g') ($n domains)"
  if is_locked; then
    info "Locked until $(fmt_time "$(lock_until)") ($(fmt_left $(($(lock_until) - $(now)))) left)"
  else
    info "No timer: 'sudo focusblock off' removes it."
  fi
}

# Run by launchd every minute. Lifts the block once the timer is up.
cmd_tick() {
  [ -f "$STATE_DIR/until" ] || { remove_timer; return 0; }
  is_locked && return 0
  [ -w "$HOSTS_FILE" ] || return 0
  if is_blocked; then unblock; else remove_timer; fi
}

cmd_lists() {
  local dir f name n
  dir="$(lists_dir)"
  info "Built-in lists (you can also pass any domain, e.g. focusblock on example.com):"
  set +f
  for f in "$dir"/*.txt; do
    name="$(basename "$f" .txt)"
    n="$(sed -e 's/#.*//' -e 's/[[:space:]]//g' "$f" | awk 'NF' | wc -l | tr -d ' ')"
    printf '  %-12s %s domains\n' "$name" "$n"
  done
}

usage() {
  cat <<'EOF'
focusblock: block distracting sites on this Mac until you've done the work.

Usage:
  sudo focusblock on <site|list>... [--for DURATION]
  sudo focusblock off
  focusblock status
  focusblock lists

Examples:
  sudo focusblock on netflix                 block Netflix until you turn it off
  sudo focusblock on netflix youtube --for 2h   block both; 'off' refuses for 2 hours
  sudo focusblock on example.com             block any domain (www. is added for you)

Options:
  --for DURATION   lock the block for 45m, 2h, 1h30m, 1d... it lifts itself when time is up
  -n, --dry-run    show what would change without touching anything
  -h, --help       show this help
  -v, --version    show the version
EOF
}

main() {
  local args=() a
  for a in "$@"; do
    case "$a" in
      -n|--dry-run) DRY_RUN=1 ;;
      *) args+=("$a") ;;
    esac
  done
  [ ${#args[@]} -gt 0 ] || { usage; exit 0; }
  set -- "${args[@]}"

  case "$1" in
    on)             shift; cmd_on "$@" ;;
    off)            cmd_off ;;
    status)         cmd_status ;;
    lists)          cmd_lists ;;
    tick)           cmd_tick ;;
    -h|--help|help) usage ;;
    -v|--version)   info "focusblock $VERSION" ;;
    *)              usage >&2; exit 1 ;;
  esac
}

main "$@"
